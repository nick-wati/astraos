DATABASE_URL="file:./dev.db"

# Optional. AstraOS runs with mock traces when these are missing.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Optional. When set, the model gateway should call LiteLLM instead of direct providers.
LITELLM_BASE_URL=""
LITELLM_API_KEY=""
LITELLM_DEFAULT_MODEL="gemini/gemini-2.5-flash-lite"

# Optional. e2b_sandbox agents simulate sandbox work when this is missing.
E2B_API_KEY=""

# Optional future LLM providers. MVP uses mock LLM responses.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Optional. If unset, AstraOS uses the local Prisma-backed mock campaign service.
CAMPAIGN_SERVICE_BASE_URL=""
CAMPAIGN_SERVICE_API_KEY=""
